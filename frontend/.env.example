# LifeSync AI Frontend Environment Variables
# In local development, Vite reads from root .env or frontend/.env
# In Vercel production deployment, configure these in the Vercel Project Settings

# Supabase Project Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# LifeSync AI Backend API URL (optional for same-domain or relative reverse-proxy)
# Leave empty in production if using Vercel API rewrites, or set to your backend deployment URL
VITE_API_URL=http://localhost:8000
